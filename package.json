{
  "name": "openexam",
  "version": "0.3.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5189 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5189 electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:win": "npm run build && electron-builder --win nsis",
    "rebuild:electron": "electron-builder install-app-deps",
    "build:seed": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/build-seed.js",
    "sync:seed": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/sync-seed.js",
    "sanitize:seed": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/sanitize-seed.js",
    "seed:essay": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/seed-essay-prompts.js",
    "import:paper": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/import-paper-json.js",
    "eval:ai": "electron scripts/eval-prompts.js",
    "rewrite:analyses": "python3 scripts/original/rewrite_seed_analyses.py",
    "export:papers": "python3 scripts/original/export_all_papers.py",
    "patch:question-quality": "ELECTRON_RUN_AS_NODE=1 electron scripts/patch-question-quality.js --seed",
    "audit:question-bank": "ELECTRON_RUN_AS_NODE=1 electron scripts/audit-question-bank.js",
    "tag:skill-points": "ELECTRON_RUN_AS_NODE=1 electron scripts/tag-skill-points.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.8.3",
    "katex": "^0.16.11",
    "openai": "^6.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.2",
    "electron-builder": "^26.8.1",
    "pdfjs-dist": "^5.5.207",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8",
    "wait-on": "^7.2.0",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.openexam.app",
    "productName": "OpenExam",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "src/main/**/*",
      "src/shared/**/*",
      "src/renderer/assets/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Tansea-web",
        "repo": "OpenExam",
        "releaseType": "release"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "extraResources": [
      {
        "from": "data/openexam.seed.db.gz",
        "to": "openexam.seed.db.gz"
      },
      {
        "from": "data/question-assets",
        "to": "question-assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  },
  "description": "OpenExam desktop AI learning platform",
  "author": "lmk1010",
  "license": "GPL-3.0-or-later"
}
